{
  "manifest_version": 2,
  "name": "Search Decode",
  "version": "1.0.0",
  "description": "Decodes Base64 search queries into URLs when valid.",

  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "*://www.google.com/search*",
    "*://www.bing.com/search*"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}